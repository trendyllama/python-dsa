{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "format",
      "type": "shell",
      "command": "uv run ruff format",
      "group": "build"
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "uv run ruff check",
      "group": "build"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest",
      "group": "test"
    },
    {
      "label": "frontend build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/src/tutorial_app/client"
      },
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "frontend lint",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/src/tutorial_app/client"
      },
      "group": "build"
    },
    {
      "label": "lint and fix",
      "type": "shell",
      "command": "uv run ruff check --fix",
      "dependsOn": ["format", "lint"],
      "group": "build"


    },
    {
      "label": "main workflow",
      "dependsOn": [
        "format",
        "lint",
        "test",
        "frontend build",
        "frontend lint"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
